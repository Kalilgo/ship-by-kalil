---
import es from '../i18n/es.json';
import en from '../i18n/en.json';
import { getAlternateLocaleUrl } from '../i18n';
import BookingButton from './BookingButton';

interface Props {
  locale?: 'es' | 'en';
}

const { locale = 'es' } = Astro.props;
const t = locale === 'en' ? en : es;

const pathname = Astro.url.pathname;
const cvHref = locale === 'en' ? '/en/cv' : '/cv';

const basePath = locale === 'en' ? '/en' : '';

const localeSwitcherOptions = [
  { code: 'es' as const, label: t.nav.languageOptionEs },
  { code: 'en' as const, label: t.nav.languageOptionEn },
];

const navLinks = [
  { label: t.nav.about, href: `${basePath}/#sobre-mi` },
  { label: t.nav.skills, href: `${basePath}/#skills` },
  { label: t.nav.projects, href: `${basePath}/#proyectos` },
  { label: t.nav.experience, href: `${basePath}/#experiencia` },
  { label: t.nav.contact, href: `${basePath}/#contacto` },
];
---

<nav id="site-nav" class="nav-site fixed top-0 left-0 right-0 z-50">
  <div class="relative z-[70] border-b border-border bg-background/80 backdrop-blur-md">
    <div class="max-w-6xl mx-auto px-4 md:px-6 py-3 flex items-center justify-between">
    <a
      href={locale === 'en' ? '/en/' : '/'}
      class="group flex items-baseline gap-0 font-heading font-bold tracking-tight text-lg md:text-xl"
      aria-label="kalil.dev — inicio"
    >
      <span class="lowercase text-transparent bg-clip-text bg-gradient-to-r from-accent-cyan via-cyan-400 to-accent">
        kalil
      </span>
      <span class="text-text-secondary/45 font-mono text-sm font-medium px-1 select-none" aria-hidden="true">&nbsp;.&nbsp;</span>
      <span class="lowercase font-mono text-sm font-semibold text-accent-cyan/90 group-hover:text-accent-cyan transition-colors">
        dev
      </span>
    </a>

    <div class="hidden lg:flex items-center gap-1">
      {navLinks.slice(0, 5).map((link) => (
        <a
          href={link.href}
          data-nav-link="true"
          class="px-3 py-2 text-sm text-text-secondary hover:text-text-primary hover:bg-surface-2 rounded-lg transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent-cyan/70 focus-visible:ring-offset-2 focus-visible:ring-offset-background"
        >
          {link.label}
        </a>
      ))}
    </div>

    <div class="flex items-center gap-3">
      <a
        href={cvHref}
        class="hidden sm:flex items-center gap-2 px-4 py-2 bg-accent-cyan text-background rounded-lg hover:bg-accent-cyan/80 transition-colors font-medium text-sm"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
          <polyline points="14 2 14 8 20 8"></polyline>
          <line x1="16" y1="13" x2="8" y2="13"></line>
          <line x1="16" y1="17" x2="8" y2="17"></line>
        </svg>
        <span>{t.nav.downloadCV}</span>
      </a>

      <div class="hidden md:flex items-center shrink-0">
        <BookingButton client:load locale={locale} />
      </div>

      <div class="relative group" id="lang-switcher">
        <button
          class="flex items-center gap-2 px-3 py-2 rounded-lg border border-border bg-surface-2 hover:border-accent-cyan hover:text-accent-cyan transition-all text-sm"
          aria-label={t.nav.language}
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"></circle>
            <line x1="2" y1="12" x2="22" y2="12"></line>
            <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
          </svg>
          <span class="uppercase text-xs font-bold">{locale}</span>
        </button>
        <div class="absolute right-0 mt-2 w-36 bg-surface-2 border border-border rounded-lg shadow-xl opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all z-50">
          {localeSwitcherOptions.map(({ code, label }) => (
            <a
              href={getAlternateLocaleUrl(pathname, code)}
              data-set-locale={code}
              class={`flex items-center gap-2 px-4 py-2.5 text-sm transition-colors first:rounded-t-lg last:rounded-b-lg ${locale === code ? 'bg-accent-cyan/10 text-accent-cyan font-medium' : 'text-text-secondary hover:bg-surface hover:text-text-primary'}`}
            >
              <span class="w-5 h-5 flex items-center justify-center rounded-full border border-current text-[9px] font-bold">{code.toUpperCase()}</span>
              {label}
            </a>
          ))}
        </div>
      </div>

      <button
        type="button"
        id="mobile-menu-toggle"
        class="lg:hidden p-2 text-text-primary hover:bg-surface-2 rounded-lg"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label={locale === 'en' ? 'Open menu' : 'Abrir menú'}
        data-label-open={locale === 'en' ? 'Open menu' : 'Abrir menú'}
        data-label-close={locale === 'en' ? 'Close menu' : 'Cerrar menú'}
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
      </button>
    </div>
    </div>
  </div>

  <div
    id="mobile-menu"
    class="hidden lg:hidden fixed inset-0 z-[60] min-h-[100dvh] flex-col bg-background"
    role="dialog"
    aria-modal="true"
    aria-label={locale === 'en' ? 'Site navigation' : 'Navegación'}
  >
    <div
      class="relative flex min-h-0 flex-1 flex-col px-5 pt-[max(1rem,env(safe-area-inset-top))] pb-[max(1.25rem,env(safe-area-inset-bottom))]"
    >
      <div class="flex shrink-0 items-center justify-between gap-4 border-b border-border/70 pb-5">
        <a
          href={locale === 'en' ? '/en/' : '/'}
          class="group flex items-baseline gap-0 font-heading font-bold tracking-tight text-lg"
          aria-label="kalil.dev — inicio"
        >
          <span class="lowercase text-transparent bg-clip-text bg-gradient-to-r from-accent-cyan via-cyan-400 to-accent">
            kalil
          </span>
          <span class="text-text-secondary/45 font-mono text-sm font-medium px-1 select-none" aria-hidden="true">&nbsp;.&nbsp;</span>
          <span class="lowercase font-mono text-sm font-semibold text-accent-cyan/90">dev</span>
        </a>
        <button
          type="button"
          id="mobile-menu-close"
          class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-border bg-surface-2 text-text-primary transition-colors hover:border-accent-cyan/50 hover:text-accent-cyan focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent-cyan/70"
          aria-label={locale === 'en' ? 'Close menu' : 'Cerrar menú'}
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M18 6 6 18"></path>
            <path d="m6 6 12 12"></path>
          </svg>
        </button>
      </div>

      <nav class="flex min-h-0 flex-1 flex-col justify-center gap-1 py-10" aria-label={locale === 'en' ? 'Sections' : 'Secciones'}>
        {navLinks.slice(0, 5).map((link) => (
          <a
            href={link.href}
            data-nav-link="true"
            class="font-heading text-[clamp(1.35rem,5vw,2rem)] font-semibold tracking-tight text-text-secondary transition-colors hover:text-accent-cyan py-4 border-b border-border/40 last:border-b-0 focus-visible:outline-none focus-visible:text-accent-cyan"
          >
            {link.label}
          </a>
        ))}
      </nav>

      <div class="mt-auto flex shrink-0 flex-col gap-4 border-t border-border/70 pt-6">
        <a
          href={cvHref}
          class="flex w-full items-center justify-center gap-2 rounded-xl bg-accent-cyan px-4 py-4 text-center text-base font-semibold text-background transition-colors hover:bg-accent-cyan/85"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
            <polyline points="14 2 14 8 20 8"></polyline>
            <line x1="16" y1="13" x2="8" y2="13"></line>
            <line x1="16" y1="17" x2="8" y2="17"></line>
          </svg>
          {t.nav.downloadCV}
        </a>

        <div class="w-full [&_a]:w-full [&_a]:justify-center">
          <BookingButton client:load locale={locale} />
        </div>

        <div class="flex gap-3">
          {localeSwitcherOptions.map(({ code, label }) => (
            <a
              href={getAlternateLocaleUrl(pathname, code)}
              data-set-locale={code}
              class={`flex flex-1 items-center justify-center gap-2 rounded-xl px-3 py-3.5 text-center text-sm font-medium transition-colors ${locale === code ? 'bg-accent-cyan/15 text-accent-cyan ring-1 ring-accent-cyan/35' : 'border border-border bg-surface-2 text-text-secondary hover:border-accent-cyan/40 hover:text-text-primary'}`}
            >
              <span class="flex h-6 w-6 items-center justify-center rounded-full border border-current text-[10px] font-bold">{code.toUpperCase()}</span>
              {label}
            </a>
          ))}
        </div>
      </div>
    </div>
  </div>
</nav>

<script>
  import { setStoredLocale, LOCALE_SCROLL_RESTORE_KEY } from '../i18n';

  const toggle = document.getElementById('mobile-menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const menuClose = document.getElementById('mobile-menu-close');

  function syncMobileMenuUi() {
    const open = !!(menu && menu.classList.contains('flex'));
    if (toggle) {
      toggle.setAttribute('aria-expanded', String(open));
      const openLabel = toggle.getAttribute('data-label-open') ?? 'Open menu';
      const closeLabel = toggle.getAttribute('data-label-close') ?? 'Close menu';
      toggle.setAttribute('aria-label', open ? closeLabel : openLabel);
    }
    document.body.style.overflow = open ? 'hidden' : '';
  }

  function closeMobileMenu() {
    if (!menu) return;
    menu.classList.add('hidden');
    menu.classList.remove('flex');
    syncMobileMenuUi();
  }

  toggle?.addEventListener('click', () => {
    if (!menu) return;
    menu.classList.toggle('hidden');
    menu.classList.toggle('flex');
    syncMobileMenuUi();
  });

  menuClose?.addEventListener('click', closeMobileMenu);

  const nav = document.getElementById('site-nav');
  const onScroll = () => {
    if (!nav) return;
    nav.classList.toggle('nav-elevated', window.scrollY > 16);
  };
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return;
    if (!menu || menu.classList.contains('hidden')) return;
    closeMobileMenu();
  });

  // Cerrar menú móvil al seleccionar una opción
  menu?.addEventListener('click', (event) => {
    const target = event.target as HTMLElement | null;
    const link = target?.closest('a');
    if (!link) return;
    closeMobileMenu();
  });

  // Cerrar menú si cambia el hash (navegación in-page)
  window.addEventListener('hashchange', closeMobileMenu);
  document.addEventListener('click', (event) => {
    const target = event.target as HTMLElement | null;
    if (!menu || !toggle || !target) return;
    const isOpen = !menu.classList.contains('hidden');
    if (!isOpen) return;
    const clickedInsideMenu = menu.contains(target);
    const clickedToggle = toggle.contains(target);
    if (!clickedInsideMenu && !clickedToggle) closeMobileMenu();
  });

  function handleLocaleSelection() {
    document.querySelectorAll('[data-set-locale]').forEach((el) => {
      el.addEventListener('pointerdown', () => {
        try {
          sessionStorage.setItem(LOCALE_SCROLL_RESTORE_KEY, String(window.scrollY));
        } catch {
          /* ignore */
        }
      });
      el.addEventListener('click', () => {
        const value = el.getAttribute('data-set-locale');
        if (value === 'es' || value === 'en') {
          setStoredLocale(value);
        }
      });
    });
  }

  function initActiveSectionSpy() {
    const sectionIds = ['sobre-mi', 'skills', 'proyectos', 'experiencia', 'contacto'];
    const navLinkEls = document.querySelectorAll('[data-nav-link]');
    if (!navLinkEls.length) return;

    const setActive = (id: string) => {
      navLinkEls.forEach((link) => {
        const href = link.getAttribute('href') || '';
        const isActive = href.includes(`#${id}`);
        link.classList.toggle('nav-link-active', isActive);
      });
    };

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            setActive(entry.target.id);
          }
        });
      },
      { threshold: 0.25, rootMargin: '-10% 0px -55% 0px' }
    );

    sectionIds.forEach((id) => {
      const section = document.getElementById(id);
      if (section) observer.observe(section);
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => {
      handleLocaleSelection();
      initActiveSectionSpy();
    });
  } else {
    handleLocaleSelection();
    initActiveSectionSpy();
  }
</script>