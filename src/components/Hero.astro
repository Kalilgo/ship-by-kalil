---
import Counter from './ui/Counter';
import HeroCodeShell from './HeroCodeShell';
import es from '../i18n/es.json';
import en from '../i18n/en.json';

interface Props {
  locale?: 'es' | 'en';
}

const { locale = 'es' } = Astro.props;
const t = locale === 'en' ? en : es;
---

<section class="relative flex min-h-[100dvh] min-h-screen items-center overflow-hidden pt-[max(5rem,env(safe-area-inset-top))] pb-28 md:pb-16">
  <div class="absolute top-28 -left-24 w-72 h-72 bg-accent/15 blur-2xl sm:blur-3xl rounded-full pointer-events-none"></div>
  <div class="absolute bottom-8 -right-24 w-72 h-72 bg-accent-cyan/20 blur-2xl sm:blur-3xl rounded-full pointer-events-none"></div>

  <div class="max-w-7xl mx-auto grid w-full items-center gap-10 px-5 sm:px-6 md:grid-cols-2 md:gap-12">
    <div class="space-y-5 sm:space-y-6 reveal min-w-0" style="--reveal-delay: 80ms;">
      <div
        class="inline-flex items-center gap-2 px-4 py-2 bg-surface-2/80 border border-accent-cyan/20 rounded-full shadow-[0_0_32px_-10px_rgba(6,182,212,0.35)]"
      >
        <span class="w-2 h-2 bg-green-500 rounded-full animate-pulse shadow-[0_0_12px_rgba(34,197,94,0.65)]"></span>
        <span class="text-text-secondary text-sm">{t.nav.available}</span>
      </div>

      <h1 class="font-heading text-[clamp(2rem,9vw,3.75rem)] font-bold leading-[1.1] tracking-tight text-text-primary md:text-6xl lg:text-7xl">
        Matías Kalil
        <span class="mt-1 block text-gradient-shimmer">
          {t.hero.title}
        </span>
      </h1>

      <p class="text-lg leading-snug text-text-secondary sm:text-xl">
        {t.hero.subtitle}
      </p>

      <p class="max-w-xl text-base leading-relaxed text-text-secondary sm:text-lg">
        {t.hero.description}
      </p>

      <div class="grid max-w-xl grid-cols-2 gap-2.5 sm:grid-cols-3 sm:gap-3">
        <Counter client:visible end={3} label={t.counter.projects} />
        <Counter client:visible end={1} label={t.counter.role} />
        <Counter client:visible end={24} suffix="h" label={t.counter.response} />
      </div>

      <div class="flex w-full max-w-xl flex-col gap-3 sm:flex-row sm:flex-wrap">
        <a href="#proyectos" class="btn-hero-primary w-full min-h-[48px] shrink-0 text-center text-sm sm:w-auto sm:min-h-0 sm:flex-none sm:text-base">
          {t.hero.viewCases}
        </a>
        <a href="#contacto" class="btn-hero-secondary w-full min-h-[48px] shrink-0 text-center text-sm sm:w-auto sm:min-h-0 sm:flex-none sm:text-base">
          {t.hero.scheduleInterview}
        </a>
      </div>

      <div class="flex items-center gap-4 pt-2">
        <a
          href="https://github.com/Kalilgo"
          target="_blank"
          rel="noopener noreferrer"
          class="p-2 text-text-secondary hover:text-text-primary transition-colors"
          aria-label="GitHub"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
          </svg>
        </a>
        <a
          href="https://www.linkedin.com/in/matias-gomez-19a1912a5/"
          target="_blank"
          rel="noopener noreferrer"
          class="p-2 text-text-secondary hover:text-text-primary transition-colors"
          aria-label="LinkedIn"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
            <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
          </svg>
        </a>
        <a
          href="mailto:gomezukalil@gmail.com"
          class="p-2 text-text-secondary hover:text-text-primary transition-colors"
          aria-label="Email"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
            <polyline points="22,6 12,13 2,6"></polyline>
          </svg>
        </a>
      </div>
    </div>

    <div class="hidden md:block relative animate-float reveal min-w-0" style="--reveal-delay: 240ms;">
      <HeroCodeShell client:load locale={locale} />
    </div>
  </div>

  <a
    href="#sobre-mi"
    class="absolute bottom-8 left-1/2 hidden -translate-x-1/2 flex-col items-center gap-1.5 text-text-secondary/40 transition-colors duration-300 hover:text-accent-cyan/70 md:flex reveal"
    style="--reveal-delay: 900ms;"
    aria-label="Ir a Sobre mí"
  >
    <span class="text-[9px] font-mono uppercase tracking-[0.25em] select-none">scroll</span>
    <svg
      class="w-5 h-5 scroll-indicator"
      fill="none"
      viewBox="0 0 24 24"
      stroke="currentColor"
      aria-hidden="true"
    >
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 9l-7 7-7-7" />
    </svg>
  </a>
</section>