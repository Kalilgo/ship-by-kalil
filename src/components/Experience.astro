---
import { experience } from '../data/experience';
import es from '../i18n/es.json';
import en from '../i18n/en.json';

interface Props {
  locale?: 'es' | 'en';
}

const { locale = 'es' } = Astro.props;
const t = locale === 'en' ? en : es;
const l = locale;
const tExperience = experience.map((item) => ({
  period: item.period[l],
  role: item.role[l],
  company: item.company[l],
  description: item.description[l],
  tech: item.tech,
  current: item.current,
}));
---

<section id="experiencia" class="py-20">
  <div class="max-w-6xl mx-auto px-6">
    <h2 class="text-3xl md:text-4xl font-bold font-heading text-text-primary mb-12">
      {t.experience.title} & <span class="text-accent-cyan">{locale === 'en' ? 'Training' : 'Formación'}</span>
    </h2>

    <div class="relative">
      <div class="absolute left-4 top-0 bottom-0 w-px bg-border md:left-1/2"></div>

      <div class="space-y-12">
        {tExperience.map((item, index) => (
          <div class={`relative flex items-start ${index % 2 === 0 ? 'md:flex-row' : 'md:flex-row-reverse'}`}>
            <div class={`absolute left-4 md:left-1/2 w-3 h-3 rounded-full transform -translate-x-1/2 mt-7 ring-2 ring-background ${item.current ? 'bg-accent-cyan shadow-[0_0_12px_rgba(6,182,212,0.6)]' : 'bg-border'}`}></div>

            <div
              class="ml-12 md:ml-0 md:w-1/2 p-6 glass-panel bg-surface-2/90 border border-border rounded-xl hover-lift hover:border-accent-cyan/60 transition-colors reveal"
              style={`--reveal-delay: ${120 + index * 100}ms;`}
            >
              <div class="flex flex-wrap items-center gap-2 mb-3">
                <span class="text-xs font-mono text-text-secondary/70 bg-background/60 border border-border/60 px-2 py-0.5 rounded">{item.period}</span>
                {item.current && (
                  <span class="px-2 py-0.5 bg-accent-cyan/15 text-accent-cyan text-xs rounded border border-accent-cyan/25 font-medium">
                    {locale === 'en' ? '● Current' : '● Actual'}
                  </span>
                )}
              </div>

              <h3 class="text-lg font-bold font-heading text-text-primary mb-1">
                {item.role}
              </h3>
              <p class="text-accent-cyan text-sm mb-3">{item.company}</p>
              <p class="text-text-secondary text-sm leading-relaxed">{item.description}</p>

              {item.tech.length > 0 && (
                <div class="flex flex-wrap gap-1.5 mt-4 pt-4 border-t border-border/40">
                  {item.tech.map((tag: string) => (
                    <span class="px-2 py-0.5 bg-background/50 text-text-secondary text-xs rounded border border-border/70 font-mono hover:border-accent-cyan/40 hover:text-accent-cyan/80 transition-colors">
                      {tag}
                    </span>
                  ))}
                </div>
              )}
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>