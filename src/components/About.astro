---
import es from '../i18n/es.json';
import en from '../i18n/en.json';

interface Props {
  locale?: 'es' | 'en';
}

const { locale = 'es' } = Astro.props;
const t = locale === 'en' ? en : es;

const highlights = [
  { icon: '📍', text: t.about.location },
  { icon: '🎓', text: t.about.education },
  { icon: '💼', text: t.about.status },
  { icon: '⚡', text: locale === 'en' ? 'React · Astro · .NET · AWS' : 'React · Astro · .NET · AWS' },
];

const skills = [
  {
    icon: '⚡',
    title: t.about.frontend,
    items: ['React', 'Astro', 'Tailwind', 'TypeScript'],
    accent: 'border-accent-cyan/30 hover:border-accent-cyan/60',
    badgeColor: 'bg-accent-cyan/10 text-accent-cyan border-accent-cyan/20',
  },
  {
    icon: '🔧',
    title: t.about.backend,
    items: ['.NET Core', 'C#', 'Node.js', 'SQL Server'],
    accent: 'border-accent/30 hover:border-accent/60',
    badgeColor: 'bg-accent/10 text-accent border-accent/20',
  },
  {
    icon: '☁️',
    title: t.about.cloud,
    items: ['AWS', 'Vercel', 'Railway'],
    accent: 'border-purple-500/30 hover:border-purple-500/60',
    badgeColor: 'bg-purple-500/10 text-purple-400 border-purple-500/20',
  },
  {
    icon: '🤖',
    title: t.about.aiTools,
    items: ['Cursor', 'Claude AI', 'Copilot'],
    accent: 'border-green-500/30 hover:border-green-500/60',
    badgeColor: 'bg-green-500/10 text-green-400 border-green-500/20',
  },
];
---

<section id="sobre-mi" class="py-20 bg-surface">
  <div class="max-w-6xl mx-auto px-6">
    <h2 class="text-3xl md:text-4xl font-bold font-heading text-text-primary mb-12" set:html={t.about.title} />

    <div class="grid md:grid-cols-2 gap-10 lg:gap-14 items-center">
      <figure
        class="flex flex-col items-center justify-center mx-auto w-full max-w-md md:max-w-none reveal md:justify-self-center"
        style="--reveal-delay: 100ms;"
      >
        <div class="relative w-full max-w-[300px] sm:max-w-[320px] animate-float">
          <div
            class="absolute -inset-3 rounded-3xl bg-gradient-to-br from-accent-cyan/25 via-accent/10 to-transparent blur-2xl opacity-70 pointer-events-none"
            aria-hidden="true"
          />
          <div class="relative rounded-3xl border border-border/60 bg-surface-2/50 p-3 sm:p-4 shadow-2xl shadow-black/30">
            <!-- Caja con proporción fija: la foto centrada (evita “aire” raro con object-cover) -->
            <div
              class="relative aspect-[3/4] w-full overflow-hidden rounded-2xl bg-gradient-to-b from-surface-2 to-background flex items-center justify-center"
            >
              <img
                src="/images/matias-kalil-portrait.png"
                alt="Retrato de Matías Kalil Gómez, desarrollador web full stack"
                width="320"
                height="400"
                loading="lazy"
                decoding="async"
                class="h-full w-full object-contain object-center select-none"
              />
            </div>
          </div>
        </div>
        <figcaption class="mt-6 max-w-sm text-center px-2">
          <h3 class="text-xl font-bold text-text-primary">{t.about.name}</h3>
          <p class="text-accent-cyan text-sm mt-1">{t.about.role}</p>
        </figcaption>
      </figure>

      <div class="space-y-6 reveal md:min-w-0" style="--reveal-delay: 180ms;">
        <p class="text-lg text-text-secondary leading-relaxed">
          {t.about.description}
        </p>

        <div class="grid sm:grid-cols-2 gap-4 pt-2">
          {highlights.map((item, index) => (
            <div
              class="flex items-center gap-2 text-text-secondary glass-panel border border-border rounded-lg p-3 hover-lift reveal"
              style={`--reveal-delay: ${260 + index * 80}ms;`}
            >
              <span>{item.icon}</span>
              <span class="text-sm">{item.text}</span>
            </div>
          ))}
        </div>

        <div class="grid sm:grid-cols-2 gap-4 pt-2">
          <article class="glass-panel border border-border rounded-xl p-5 hover-lift reveal" style="--reveal-delay: 380ms;">
            <p class="text-xs uppercase tracking-wide text-accent-cyan mb-2">{t.about.howIWork}</p>
            <p class="text-text-secondary text-sm">
              {t.about.howIWorkDesc}
            </p>
          </article>
          <article class="glass-panel border border-border rounded-xl p-5 hover-lift reveal" style="--reveal-delay: 460ms;">
            <p class="text-xs uppercase tracking-wide text-accent-cyan mb-2">{t.about.valueToTeam}</p>
            <p class="text-text-secondary text-sm">
              {t.about.valueToTeamDesc}
            </p>
          </article>
        </div>
      </div>
    </div>

    <div class="mt-16">
      <h3 class="text-2xl font-bold font-heading text-text-primary mb-8 text-center" set:html={t.about.techStack} />
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4">
        {skills.map((skill, index) => (
          <div
            class={`glass-panel border rounded-xl p-5 hover-lift reveal transition-colors duration-300 ${skill.accent}`}
            style={`--reveal-delay: ${index * 80}ms;`}
          >
            <div class="flex items-center gap-2 mb-3">
              <span class="text-xl">{skill.icon}</span>
              <h4 class="font-bold text-text-primary">{skill.title}</h4>
            </div>
            <div class="flex flex-wrap gap-2">
              {skill.items.map((item) => (
                <span class={`px-2 py-1 text-xs rounded-md border font-mono ${skill.badgeColor}`}>
                  {item}
                </span>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>