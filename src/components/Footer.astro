---
import es from '../i18n/es.json';
import en from '../i18n/en.json';

interface Props {
  locale?: 'es' | 'en';
}

const { locale = 'es' } = Astro.props;
const t = locale === 'en' ? en : es;

const currentYear = new Date().getFullYear();
const basePath = locale === 'en' ? '/en' : '';
---

<footer class="py-12 border-t border-border bg-surface/50">
  <div class="max-w-6xl mx-auto px-6">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8 mb-8">
      <div class="md:col-span-2">
        <a
          href={basePath || '/'}
          class="group flex items-baseline gap-0 font-heading font-bold tracking-tight text-lg mb-4"
          aria-label="kalil.dev — inicio"
        >
          <span class="lowercase text-transparent bg-clip-text bg-gradient-to-r from-accent-cyan via-cyan-400 to-accent">
            kalil
          </span>
          <span class="text-text-secondary/45 font-mono text-sm font-medium px-1 select-none" aria-hidden="true">&nbsp;.&nbsp;</span>
          <span class="lowercase font-mono text-sm font-semibold text-accent-cyan/90 group-hover:text-accent-cyan transition-colors">
            dev
          </span>
        </a>
        <p class="text-text-secondary text-sm max-w-sm mb-6">
          {locale === 'en' 
            ? 'Full Stack Developer specializing in React, Astro, .NET, and AWS. Building digital products that people love.'
            : 'Desarrollador Web Full Stack especializado en React, Astro, .NET y AWS. Creando productos digitales que la gente ama.'}
        </p>
        <div class="flex items-center gap-4">
          <a
            href="https://github.com/Kalilgo"
            target="_blank"
            rel="noopener noreferrer"
            class="p-2 text-text-secondary hover:text-text-primary hover:bg-surface-2 rounded-lg transition-all"
            aria-label="GitHub"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
            </svg>
          </a>
          <a
            href="https://linkedin.com/in/matiaskalil"
            target="_blank"
            rel="noopener noreferrer"
            class="p-2 text-text-secondary hover:text-text-primary hover:bg-surface-2 rounded-lg transition-all"
            aria-label="LinkedIn"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
              <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
            </svg>
          </a>
          <a
            href="mailto:gomezukalil@gmail.com"
            class="p-2 text-text-secondary hover:text-text-primary hover:bg-surface-2 rounded-lg transition-all"
            aria-label="Email"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
              <polyline points="22,6 12,13 2,6"></polyline>
            </svg>
          </a>
        </div>
      </div>

      <div>
        <h4 class="text-text-primary font-semibold mb-4">
          {locale === 'en' ? 'Navigation' : 'Navegación'}
        </h4>
        <ul class="space-y-2">
          <li>
            <a href={`${basePath}/#sobre-mi`} class="text-text-secondary text-sm hover:text-accent-cyan transition-colors">
              {t.nav.about}
            </a>
          </li>
          <li>
            <a href={`${basePath}/#skills`} class="text-text-secondary text-sm hover:text-accent-cyan transition-colors">
              {t.nav.skills}
            </a>
          </li>
          <li>
            <a href={`${basePath}/#proyectos`} class="text-text-secondary text-sm hover:text-accent-cyan transition-colors">
              {t.nav.projects}
            </a>
          </li>
          <li>
            <a href={`${basePath}/#experiencia`} class="text-text-secondary text-sm hover:text-accent-cyan transition-colors">
              {t.nav.experience}
            </a>
          </li>
          <li>
            <a href={`${basePath}/#contacto`} class="text-text-secondary text-sm hover:text-accent-cyan transition-colors">
              {t.nav.contact}
            </a>
          </li>
        </ul>
      </div>

      <div>
        <h4 class="text-text-primary font-semibold mb-4">
          {locale === 'en' ? 'Contact' : 'Contacto'}
        </h4>
        <ul class="space-y-2">
          <li>
            <a href="mailto:gomezukalil@gmail.com" class="text-text-secondary text-sm hover:text-accent-cyan transition-colors">
              gomezukalil@gmail.com
            </a>
          </li>
          <li>
            <a
              href="/CV.pdf"
              download="Matias-Kalil-Gomez-CV.pdf"
              class="inline-flex items-center gap-2 text-accent-cyan text-sm hover:underline"
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                <polyline points="7 10 12 15 17 10"></polyline>
                <line x1="12" y1="15" x2="12" y2="3"></line>
              </svg>
              {t.footer.downloadCV}
            </a>
          </li>
        </ul>
      </div>
    </div>

    <div class="pt-8 border-t border-border flex flex-col md:flex-row items-center justify-between gap-4">
      <p class="text-text-secondary text-sm">
        © {currentYear} Matías Kalil Gómez. {t.footer.rights}
      </p>
      <p class="text-text-secondary text-xs">
        {locale === 'en' 
          ? 'Built with Astro & React'
          : 'Hecho con Astro & React'}
      </p>
    </div>
  </div>
</footer>