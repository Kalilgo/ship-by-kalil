---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import CvPage from '../components/CvPage.astro';
import { cvByLocale, cvPageLabels } from '../data/cv';

const cvContent = cvByLocale.es;
const labels = cvPageLabels.es;
---

<Layout title="CV - Matías Kalil Gómez" locale="es">
  <Navbar locale="es" />
  <div id="main-content" tabindex="-1" class="outline-none">
    <CvPage cvContent={cvContent} labels={labels} />
  </div>
  <Footer locale="es" />
</Layout>
