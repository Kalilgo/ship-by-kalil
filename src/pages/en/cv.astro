---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import CvPage from '../../components/CvPage.astro';
import { cvByLocale, cvPageLabels } from '../../data/cv';

const cvContent = cvByLocale.en;
const labels = cvPageLabels.en;
---

<Layout title="CV - Matías Kalil Gómez" locale="en">
  <Navbar locale="en" />
  <div id="main-content" tabindex="-1" class="outline-none">
    <CvPage cvContent={cvContent} labels={labels} />
  </div>
  <Footer locale="en" />
</Layout>
