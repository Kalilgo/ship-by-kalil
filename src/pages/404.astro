---
import Layout from '../layouts/Layout.astro';
import { getLocaleFromUrl } from '../i18n';

const locale = getLocaleFromUrl(Astro.url.pathname);
const isEn = locale === 'en';
const homeHref = isEn ? '/en/' : '/';

const title = isEn ? 'Page not found — 404' : 'Página no encontrada — 404';
const description = isEn
  ? 'The page you requested does not exist.'
  : 'La página que buscás no existe.';
---

<Layout title={title} description={description} locale={locale} robots="noindex, nofollow">
  <div class="not-found">
    <div class="not-found__ambient" aria-hidden="true">
      <div class="not-found__glow not-found__glow--a"></div>
      <div class="not-found__glow not-found__glow--b"></div>
      <div class="not-found__grid"></div>
    </div>

    <main class="not-found__main">
      <div class="not-found__inner">
        <p class="not-found__code" aria-hidden="true">404</p>

        <section class="not-found__card">
          <div class="not-found__card-shine" aria-hidden="true"></div>
          <div class="not-found__card-inner">
            <div class="not-found__badge">
              <span class="not-found__dot"></span>
              <span>{isEn ? 'Not found' : 'No encontrado'}</span>
            </div>

            <h1 class="not-found__title">
              {isEn ? 'This page doesn’t exist.' : 'Esta página no existe.'}
            </h1>
            <p class="not-found__lead">
              {isEn
                ? 'The URL may be mistyped, or the page was moved.'
                : 'La dirección puede estar mal escrita o la página ya no está disponible.'}
            </p>

            <div class="not-found__actions">
              <a href={homeHref} class="not-found__btn not-found__btn--primary">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                  <polyline points="9 22 9 12 15 12 15 22"></polyline>
                </svg>
                {isEn ? 'Back to home' : 'Volver al inicio'}
              </a>
              <a href={homeHref + '#contacto'} class="not-found__btn not-found__btn--ghost">
                {isEn ? 'Contact' : 'Contacto'}
              </a>
            </div>
          </div>
        </section>
      </div>
    </main>
  </div>
</Layout>

<style>
  .not-found {
    position: relative;
    min-height: 100dvh;
    min-height: 100svh;
    background: #0a0a0f;
    overflow: hidden;
  }

  .not-found__ambient {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .not-found__glow {
    position: absolute;
    border-radius: 50%;
    filter: blur(80px);
    opacity: 0.55;
  }

  .not-found__glow--a {
    width: min(520px, 70vw);
    height: min(520px, 70vw);
    left: -10%;
    top: -15%;
    background: radial-gradient(circle, rgba(37, 99, 235, 0.35), transparent 70%);
  }

  .not-found__glow--b {
    width: min(480px, 65vw);
    height: min(480px, 65vw);
    right: -8%;
    bottom: -10%;
    background: radial-gradient(circle, rgba(6, 182, 212, 0.22), transparent 70%);
  }

  .not-found__grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.03) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.03) 1px, transparent 1px);
    background-size: 48px 48px;
    mask-image: radial-gradient(ellipse 80% 60% at 50% 45%, black 20%, transparent 75%);
    opacity: 0.45;
  }

  .not-found__main {
    position: relative;
    z-index: 1;
    min-height: 100dvh;
    min-height: 100svh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: clamp(1.5rem, 4vw, 2.5rem);
  }

  .not-found__inner {
    width: 100%;
    max-width: 28rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .not-found__code {
    margin: 0 0 -0.12em;
    font-family: Syne, sans-serif;
    font-weight: 800;
    font-size: clamp(5.5rem, 28vw, 10rem);
    line-height: 0.88;
    letter-spacing: -0.06em;
    color: transparent;
    background: linear-gradient(135deg, rgba(6, 182, 212, 0.45) 0%, rgba(37, 99, 235, 0.35) 45%, rgba(240, 240, 245, 0.08) 100%);
    -webkit-background-clip: text;
    background-clip: text;
    user-select: none;
    filter: drop-shadow(0 0 40px rgba(37, 99, 235, 0.15));
  }

  .not-found__card {
    position: relative;
    width: 100%;
    border-radius: 1.25rem;
    padding: 1px;
    background: linear-gradient(
      135deg,
      rgba(6, 182, 212, 0.35),
      rgba(42, 42, 58, 0.9) 40%,
      rgba(37, 99, 235, 0.25)
    );
    box-shadow:
      0 0 0 1px rgba(255, 255, 255, 0.06) inset,
      0 24px 80px rgba(0, 0, 0, 0.55),
      0 0 100px rgba(37, 99, 235, 0.08);
  }

  .not-found__card-shine {
    position: absolute;
    inset: 0;
    border-radius: 1.25rem;
    background: linear-gradient(105deg, transparent 40%, rgba(255, 255, 255, 0.04) 50%, transparent 60%);
    pointer-events: none;
  }

  .not-found__card-inner {
    position: relative;
    border-radius: calc(1.25rem - 1px);
    background: linear-gradient(165deg, rgba(18, 18, 26, 0.92), rgba(10, 10, 15, 0.98));
    backdrop-filter: blur(16px);
    padding: clamp(1.75rem, 4vw, 2.25rem);
  }

  .not-found__badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 0.85rem;
    border-radius: 999px;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(136, 136, 170, 0.95);
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
  }

  .not-found__dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #06b6d4;
    box-shadow: 0 0 12px rgba(6, 182, 212, 0.7);
  }

  .not-found__title {
    margin: 1.1rem 0 0;
    font-family: Syne, sans-serif;
    font-weight: 800;
    font-size: clamp(1.5rem, 4.5vw, 1.875rem);
    line-height: 1.2;
    color: #f0f0f5;
    letter-spacing: -0.02em;
  }

  .not-found__lead {
    margin: 0.75rem 0 0;
    font-size: 0.9375rem;
    line-height: 1.6;
    color: #8888aa;
    max-width: 22rem;
    margin-left: auto;
    margin-right: auto;
  }

  .not-found__actions {
    margin-top: 1.75rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    justify-content: center;
  }

  .not-found__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.7rem 1.25rem;
    border-radius: 0.625rem;
    font-size: 0.9375rem;
    font-weight: 600;
    text-decoration: none;
    transition:
      transform 200ms ease,
      box-shadow 200ms ease,
      background-color 200ms ease,
      border-color 200ms ease,
      color 200ms ease;
  }

  .not-found__btn--primary {
    color: #fff;
    background: linear-gradient(135deg, #2563eb, #1d4ed8);
    box-shadow: 0 8px 28px rgba(37, 99, 235, 0.35);
  }

  .not-found__btn--primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 12px 36px rgba(37, 99, 235, 0.45);
  }

  .not-found__btn--ghost {
    color: #f0f0f5;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(42, 42, 58, 0.9);
  }

  .not-found__btn--ghost:hover {
    border-color: rgba(6, 182, 212, 0.55);
    color: #22d3ee;
    transform: translateY(-2px);
  }

  @media (prefers-reduced-motion: reduce) {
    .not-found__btn--primary:hover,
    .not-found__btn--ghost:hover {
      transform: none;
    }
  }
</style>
