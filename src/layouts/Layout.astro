---
import '../styles/global.css';
import GlobalDock from '../components/GlobalDock';
import ScrollToTop from '../components/ScrollToTop';
import WhatsAppButton from '../components/WhatsAppButton';
import CommandPalette from '../components/CommandPalette';
import Background3D from '../components/Background3D';
import { ViewTransitions } from 'astro:transitions';
import { LOCALE_SCROLL_RESTORE_KEY } from '../i18n';

interface Props {
  title?: string;
  description?: string;
  canonicalUrl?: string;
  locale?: string;
  /** e.g. "noindex, nofollow" for 404 */
  robots?: string;
}

const {
  title = 'Matías Kalil Gómez — Full Stack Developer',
  description = 'Desarrollador Web Full Stack especializado en React, Astro, .NET y AWS. Disponible para proyectos freelance.',
  canonicalUrl = Astro.url.href,
  locale = 'es',
  robots = 'index, follow',
} = Astro.props;

const siteOrigin = (import.meta.env.SITE as string | undefined)?.replace(/\/$/, '') ?? '';
const ogImageUrl = siteOrigin ? `${siteOrigin}/og-image.svg` : new URL('/og-image.svg', canonicalUrl).href;

const currentPath = Astro.url.pathname;
const hreflangEs = siteOrigin
  ? `${siteOrigin}${currentPath.replace(/^\/en/, '') || '/'}`
  : canonicalUrl;
const hreflangEn = siteOrigin
  ? `${siteOrigin}${currentPath === '/' ? '/en/' : currentPath.startsWith('/en') ? currentPath : `/en${currentPath}`}`
  : `${siteOrigin || ''}/en${currentPath}`;
---

<!doctype html>
<html lang={locale} data-section="hero">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="es" href={hreflangEs} />
    <link rel="alternate" hreflang="en" href={hreflangEn} />
    <link rel="alternate" hreflang="x-default" href={hreflangEs} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content={locale === 'en' ? 'en_US' : 'es_AR'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:site" content="@matiaskalil" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Syne:wght@700;800&family=DM+Sans:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#0A0A0F" />
    <ViewTransitions>
      <style is:global>
        html[data-astro-transition]::view-transition-old(root) {
          animation: 200ms ease-out both vt-fade-out;
        }
        html[data-astro-transition]::view-transition-new(root) {
          animation: 250ms ease-in 50ms both vt-fade-in;
        }
        @keyframes vt-fade-out {
          from { opacity: 1; }
          to { opacity: 0; }
        }
        @keyframes vt-fade-in {
          from { opacity: 0; }
          to { opacity: 1; }
        }
      </style>
    </ViewTransitions>
  </head>
  <body class="bg-background text-text-primary font-body antialiased">
    <a href="#main-content" class="fixed -top-40 left-4 z-[9999] rounded-b-lg bg-accent-cyan px-4 py-2 text-sm font-semibold text-background shadow-lg transition-all focus:top-0 focus:outline-none">
      {locale === 'en' ? 'Skip to content' : 'Ir al contenido'}
    </a>

    <div id="scroll-progress" aria-hidden="true"></div>

    <Background3D client:visible />
    <slot />

    <script define:vars={{ localeScrollKey: LOCALE_SCROLL_RESTORE_KEY }}>
      (() => {
        try {
          const raw = sessionStorage.getItem(localeScrollKey);
          if (raw == null) return;
          sessionStorage.removeItem(localeScrollKey);
          const y = parseInt(raw, 10);
          if (Number.isNaN(y) || y < 0) return;
          const apply = () => {
            const max = Math.max(0, document.documentElement.scrollHeight - window.innerHeight);
            window.scrollTo(0, Math.min(y, max));
          };
          apply();
          document.addEventListener('DOMContentLoaded', apply, { once: true });
          window.addEventListener('load', apply, { once: true });
          requestAnimationFrame(() => requestAnimationFrame(apply));
        } catch {
          /* sessionStorage blocked */
        }
      })();
    </script>

    <GlobalDock client:idle />
    <ScrollToTop client:idle />
    <WhatsAppButton client:idle />
    <CommandPalette client:idle locale={locale} />

    <script is:inline>
      (() => {
        /* View Transitions re-ejecuta is:inline scripts → limpiamos instancias previas */
        document.querySelector('.pointer-spotlight')?.remove();
        if (window.__portfolioScrollHandler) {
          window.removeEventListener('scroll', window.__portfolioScrollHandler);
        }
        if (window.__portfolioRevealObserver) {
          window.__portfolioRevealObserver.disconnect();
        }
        if (window.__portfolioSectionObserver) {
          window.__portfolioSectionObserver.disconnect();
        }

        const initMotion = () => {
          const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
          const coarsePointer = window.matchMedia('(pointer: coarse)').matches;

          if (!prefersReducedMotion) {
            document.body.classList.add('motion-enabled');
          }

          if (!prefersReducedMotion && !coarsePointer) {
            const spot = document.createElement('div');
            spot.className = 'pointer-spotlight';
            spot.setAttribute('aria-hidden', 'true');
            document.body.prepend(spot);

            let lastX = window.innerWidth * 0.5;
            let lastY = window.innerHeight * 0.35;
            let pending = false;
            window.addEventListener(
              'pointermove',
              (e) => {
                lastX = e.clientX;
                lastY = e.clientY;
                if (pending) return;
                pending = true;
                requestAnimationFrame(() => {
                  spot.style.setProperty('--x', lastX + 'px');
                  spot.style.setProperty('--y', lastY + 'px');
                  pending = false;
                });
              },
              { passive: true }
            );
          }

          const revealItems = document.querySelectorAll('.reveal');
          if (!revealItems.length) return;

          const observer = new IntersectionObserver(
            (entries, obs) => {
              entries.forEach((entry) => {
                if (!entry.isIntersecting) return;
                entry.target.classList.add('is-visible');
                obs.unobserve(entry.target);
              });
            },
            { threshold: 0.2, rootMargin: '0px 0px -60px 0px' }
          );

          window.__portfolioRevealObserver = observer;
          revealItems.forEach((item) => observer.observe(item));
        };

        const initSectionColors = () => {
          const sections = [
            { id: 'sobre-mi', attr: 'sobre-mi' },
            { id: 'skills', attr: 'skills' },
            { id: 'proyectos', attr: 'proyectos' },
            { id: 'experiencia', attr: 'experiencia' },
            { id: 'contacto', attr: 'contacto' },
          ];
          const html = document.documentElement;
          const sectionEls = sections
            .map((s) => ({ el: document.getElementById(s.id), attr: s.attr }))
            .filter((s) => s.el);

          if (!sectionEls.length) return;

          const observer = new IntersectionObserver(
            (entries) => {
              const visible = entries
                .filter((e) => e.isIntersecting)
                .sort((a, b) => b.intersectionRatio - a.intersectionRatio);
              if (visible.length > 0) {
                const best = sectionEls.find(
                  (s) => s.el === visible[0].target
                );
                if (best) html.setAttribute('data-section', best.attr);
              } else {
                const firstEl = sectionEls[0].el!;
                if (firstEl && firstEl.getBoundingClientRect().top > 0) {
                  html.setAttribute('data-section', 'hero');
                }
              }
            },
            { threshold: [0, 0.15, 0.3, 0.45, 0.6] }
          );

          window.__portfolioSectionObserver = observer;
          sectionEls.forEach((s) => observer.observe(s.el!));
        };

        const initSwipeSections = () => {
          if (typeof document === 'undefined') return;
          const coarse = window.matchMedia('(pointer: coarse)').matches;
          if (!coarse) return;

          const getSections = function () {
            return Array.from(document.querySelectorAll('#main-content > section'));
          };

          let touchX = 0;
          let touchY = 0;
          let touchTime = 0;

          document.addEventListener('touchstart', function (e) {
            if (e.touches.length !== 1) return;
            var t = e.touches[0];
            touchX = t.clientX;
            touchY = t.clientY;
            touchTime = Date.now();
          }, { passive: true });

          document.addEventListener('touchend', function (e) {
            if (e.changedTouches.length !== 1) return;
            var t = e.changedTouches[0];
            var dx = t.clientX - touchX;
            var dy = t.clientY - touchY;
            var dt = Date.now() - touchTime;

            if (dt > 400) return;
            if (Math.abs(dx) < 60 || Math.abs(dy) > Math.abs(dx) * 1.5) return;

            var sections = getSections();
            if (!sections.length) return;

            var viewCenter = window.scrollY + window.innerHeight / 2;
            var currentIdx = 0;
            sections.forEach(function (s, i) {
              var top = s.offsetTop;
              var bottom = top + s.offsetHeight;
              if (viewCenter >= top && viewCenter < bottom) currentIdx = i;
            });

            var nextIdx = dx < 0
              ? Math.min(currentIdx + 1, sections.length - 1)
              : Math.max(currentIdx - 1, 0);

            if (nextIdx === currentIdx) return;

            var target = sections[nextIdx];
            window.scrollTo({
              top: target.offsetTop - 16,
              behavior: 'smooth',
            });

            try { navigator.vibrate(12); } catch (e) { /* no haptics */ }
          }, { passive: true });
        };

        const initScrollUI = () => {
          const progressEl = document.getElementById('scroll-progress');
          let ticking = false;

          const handler = () => {
            if (!ticking) {
              requestAnimationFrame(() => {
                const scrollTop = window.scrollY;
                const docHeight = document.documentElement.scrollHeight - window.innerHeight;
                if (progressEl && docHeight > 0) {
                  progressEl.style.width = ((scrollTop / docHeight) * 100).toFixed(1) + '%';
                }
                ticking = false;
              });
              ticking = true;
            }
          };

          window.__portfolioScrollHandler = handler;
          window.addEventListener('scroll', handler, { passive: true });
          handler();
        };

        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', () => {
            initMotion();
            initScrollUI();
            initSectionColors();
            initSwipeSections();
          }, { once: true });
        } else {
          initMotion();
          initScrollUI();
          initSectionColors();
          initSwipeSections();
        }
      })();
    </script>
  </body>
</html>

<style is:global>
  /*
   * scroll-behavior: smooth en el html entero en móvil suele pelearse con el inercia nativo
   * y se nota “trabado”. Solo en puntero fino (ratón / precisión) mantenemos smooth.
   */
  html {
    scroll-behavior: auto;
  }

  @media (prefers-reduced-motion: no-preference) and (pointer: fine) {
    html {
      scroll-behavior: smooth;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }

    *,
    *::before,
    *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
    }
  }

  ::selection {
    background-color: #2563eb;
    color: white;
  }

  :focus {
    outline-color: #22d3ee;
  }

  :focus:not(:focus-visible) {
    outline: none;
  }

  :focus-visible {
    outline: 2px solid #06b6d4;
    outline-offset: 2px;
    box-shadow: 0 0 0 4px rgba(6, 182, 212, 0.2);
  }
</style>